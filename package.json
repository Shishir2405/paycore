    "exceljs": "^4.4.0",
    "jose": "^5.9.6",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.5",
    "motion": "^11.15.0",
    "next": "15.1.6",
    "nodemailer": "^9.0.1",
    "otplib": "^13.4.1",
    "papaparse": "^5.4.1",
    "pdf-lib": "^1.17.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.54.2",
    "recharts": "^2.15.0",
