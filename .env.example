# ─────────────────────────────────────────────────────────────────────────────
# PayCore environment configuration
#
# NOTE: The live email/SMS provider toggle lives in the DB `settings` collection,
# editable from Settings → Email/SMS Settings at runtime. The provider values
# below are only FALLBACK/seed values used before an admin configures them.
# ─────────────────────────────────────────────────────────────────────────────

# App
NODE_ENV=development
APP_URL=http://localhost:3000
APP_NAME=PayCore

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/paycore

# Auth — generate strong random values (e.g. `openssl rand -base64 48`)
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=900            # seconds (15 min)
JWT_REFRESH_TTL=2592000       # seconds (30 days)

# Field-level encryption key for PAN / Aadhaar / bank account (32-byte base64)
FIELD_ENCRYPTION_KEY=change-me-32-byte-base64-key

# Redis (BullMQ background jobs — payroll runs, bulk import/export, reminders)
REDIS_URL=redis://127.0.0.1:6379

# File storage (S3 / Cloudflare R2) — KYC docs, payslip PDFs, import files
S3_ENDPOINT=
S3_REGION=ap-south-1
S3_BUCKET=paycore-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Email FALLBACK — Gmail SMTP (live values come from DB settings collection)
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=

# Email FALLBACK — Brevo
BREVO_API_KEY=

# SMS FALLBACK — MSG91 / Twilio (live values come from DB settings collection)
SMS_API_KEY=

# Seed — initial SuperAdmin (used by `npm run seed`)
SEED_COMPANY_NAME=Acme Corp Pvt Ltd
SEED_ADMIN_EMAIL=admin@paycore.local
SEED_ADMIN_PASSWORD=ChangeMe@123
